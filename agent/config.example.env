# 只放配置名和非敏感默认值，不要把真实密钥或浏览器登录态提交到仓库。

# 当前主路线：复用已登录浏览器页面自动下载本地推报表。
BROWSER_PROFILE_DIR=./runtime/chrome-profile
BROWSER_SOURCE_PROFILE_DIR=<set-your-local-Chrome-profile-path>
BROWSER_PROFILE_NAME=Default
BROWSER_COPY_PROFILE=false
BROWSER_HEADLESS=false
BROWSER_CHANNEL=chrome
BROWSER_TIMEOUT_SECONDS=60
LOCAL_PUSH_REPORT_URL=https://localads.chengzijianzhan.cn/
DOWNLOAD_DIR=./inputs
SCHEDULE_TIME=09:00
REPORT_DATE_MODE=mtd_to_yesterday
BROWSER_REPORT_CONFIG=./browser_download_config.json
LOCAL_PUSH_ACCOUNT_ID=

# 以下 API 配置保留为未来可选路线，当前不要求填写。
OCEANENGINE_BASE_URL=https://api.oceanengine.com
OCEANENGINE_TOKEN_URL=
OCEANENGINE_APP_ID=
OCEANENGINE_APP_SECRET=
OCEANENGINE_REFRESH_TOKEN=
OCEANENGINE_ACCESS_TOKEN=
OCEANENGINE_LOCAL_ACCOUNT_ID=

# 已确认的只读项目列表路径；报表路径需根据应用实际可用接口填写。
OCEANENGINE_PROJECT_LIST_PATH=/open_api/v3.0/local/project/list/
OCEANENGINE_REPORT_PATH=
OCEANENGINE_REPORT_METHOD=

# 第一版可以填写本地导出的石墨反馈表；真实石墨 API 通过验收后再配置。
SHIMO_FEEDBACK_EXPORT=

DATABASE_URL=postgresql://localhost:5432/ad_agent

# Multi-Agent / DeepSeek 配置。复制本文件为 agent/.env 后填写；不要提交 agent/.env。
# DeepSeek 当前官方推荐模型名为 deepseek-flash；旧名 deepseek-v4-flash 仍兼容但已是 legacy alias。
AGENT_ENABLED=false
AGENT_PROVIDER=deepseek
AGENT_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_TEMPERATURE=0
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_RETRIES=2
AGENT_MAX_TOTAL_CALLS=0
AGENT_MAX_DATA_CALLS=0
AGENT_MAX_DIAGNOSIS_CALLS=0
AGENT_MAX_CONTENT_CALLS=0
AGENT_MAX_STRATEGY_CALLS=0
AGENT_TRACE_ENABLED=false

PIPELINE_VERSION=v3-browser-daily
TIMEZONE=Asia/Shanghai
